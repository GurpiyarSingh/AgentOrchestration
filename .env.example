# Copy to .env and fill in. Never commit .env.

# Optional. Everything important is set in the UI (Settings):
#  - the OpenAI API key is entered and verified in Settings and stored in the OS credential store
#    (environment variables are NOT used for the key);
#  - the default model is chosen in Settings → Models.

# --- LLM ---
# Optional: proxy or OpenAI-compatible gateway
# OPENAI_BASE_URL=

# Fallback default model if none is chosen in Settings. Format "provider:model".
DEFAULT_MODEL=
CHEAP_MODEL=

# --- Later providers ---
# ANTHROPIC_API_KEY=

# --- Storage ---
APP_DATA_DIR=./data
# Short path recommended on Windows (worktrees + node_modules get long), e.g. C:\aw
WORKSPACES_DIR=./workspaces

# --- Git / GitHub (optional; prefer storing the token via Settings -> Git, which uses the OS keyring) ---
# GITHUB_TOKEN=
GIT_AUTHOR_NAME=Agent Orchestrator
GIT_AUTHOR_EMAIL=agents@localhost

# --- Safety limits ---
MAX_COST_PER_RUN_USD=2.00
MAX_DAILY_COST_USD=10.00
MAX_AGENT_DEPTH=3
RUNNER_TIMEOUT_SECONDS=300

# --- Misc ---
LOG_LEVEL=INFO
